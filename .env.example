# Every provider is optional. With none, agents run in offline sim mode.
# Pick each agent's model in-game: press Esc and use "Agent brains".

# Free + local: Ollama is auto-detected at this URL (default shown).
# OLLAMA_URL=http://localhost:11434

# Claude
# ANTHROPIC_API_KEY=
# TENNEX_EFFORT=low

# OpenRouter (hosted open models; comma-separated model slugs)
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nousresearch/hermes-3-llama-3.1-405b

# Any other OpenAI-compatible server (LM Studio, vLLM, llama.cpp, an agent's API...)
# OPENAI_COMPAT_NAME=Hermes Agent
# OPENAI_COMPAT_URL=http://localhost:8000/v1
# OPENAI_COMPAT_KEY=
# OPENAI_COMPAT_MODELS=hermes

# Default model for agents you haven't set yet, e.g. ollama:hermes3 or claude:claude-opus-5-5
# TENNEX_MODEL=
